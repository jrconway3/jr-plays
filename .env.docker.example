APP_PORT=8080
MYSQL_ROOT_PASSWORD=root

# WordPress site URL (host only, scheme/port are auto-detected or can be overridden via SITE_SCHEME).
# For local Docker: use localhost or 127.0.0.1 and set APP_PORT above.
SITE_URL=localhost

WP_DB_HOST=host.docker.internal
WP_DB_PREFIX=wp_
WP_DB_PORT=3306
WP_DB_NAME=jr_local
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress

# Credentials for the docker-managed MariaDB container (not used when WP_DB_HOST != db).
# Must not be root — MariaDB's MYSQL_USER init conflicts with the built-in root account.
DOCKER_DB_USER=wordpress
DOCKER_DB_PASSWORD=wordpress

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025